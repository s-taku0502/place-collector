# Convex Deployment Configuration
# This variable is used in Production and Preview environments to deploy your Convex project
# This variable is not needed in development.
# You can create a Production or Preview deploy key at https://dashboard.convex.dev/project/settings#production-deploy-keys
CONVEX_DEPLOY_KEY=

# ============================================================================
# IMPORTANT: Production Authentication Configuration
# ============================================================================
# These variables are REQUIRED for production to ensure Convex auth cookies
# work correctly. Without these, users will lose their session after re-login.
#
# Set these to your production domain (e.g., https://spotstock.vercel.app)
# See PRODUCTION_AUTH_FIX.md for detailed instructions
# ============================================================================

# Convex Auth Cookie Domain Configuration
# Required in production to set the correct cookie domain for authentication
# Example: https://spotstock.vercel.app
CONVEX_SITE_URL=

# Next.js Public Site URL
# Used by the application to reference the production domain
# Example: https://spotstock.vercel.app
NEXT_PUBLIC_SITE_URL=

# Convex Client URL
# Your Convex deployment URL from the Convex dashboard
# Example: https://xxxxx.convex.cloud
NEXT_PUBLIC_CONVEX_URL=

# ============================================================================
# Google Maps Configuration
# ============================================================================
# Required for Google Maps functionality
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ============================================================================
# Optional: Debug Configuration
# ============================================================================
# Enable debug auth page in production (use with caution)
# This exposes authentication debugging information at /debug-auth
# Only enable temporarily for troubleshooting
# ENABLE_DEBUG_AUTH=false
